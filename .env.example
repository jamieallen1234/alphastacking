# Contact form (server-only — set in Vercel Project → Settings → Environment Variables)
# Sign up at https://resend.com — verify a sending domain or use onboarding@resend.dev for tests.
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
FEEDBACK_FROM_EMAIL=

# Optional spam protection (https://developers.cloudflare.com/turnstile/)
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Daily X/Twitter posting (developer.x.com — App must have Read+Write user auth,
# generate the access token AFTER setting that permission)
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Vercel's documented convention: set this and Vercel Cron auto-sends it as a
# bearer token on scheduled hits to /api/social-post. Also used for manual test calls.
CRON_SECRET=
